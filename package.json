{
  "name": "@local/dsh-local-savings",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "CostOps Hub (省流中台) — a cross-session token cost ledger for DeepSeek Harness: official list prices per request, local-vs-cloud route rules, session drill-down and CSV export.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "tools/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node tools/host-smoke.mjs && node tools/host-config-smoke.mjs && node tools/test-client.mjs && node tools/detail-check.mjs"
  },
  "license": "MIT",
  "author": "Ivan Yin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yinmyu/dsh-costops-hub.git"
  },
  "homepage": "https://github.com/yinmyu/dsh-costops-hub#readme",
  "bugs": {
    "url": "https://github.com/yinmyu/dsh-costops-hub/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "token-cost",
    "llm-pricing",
    "cost-tracking",
    "local-llm"
  ]
}
